{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "short_name": "مدقق الفواتير",
  "name": "مدقق باركود الفواتير والأوردرات | Offline Barcode Auditor",
  "description": "تطبيق جرد وتدقيق الفواتير والأوردرات أوفلاين مع قارئ الباركود الخطي 1D وكاميرا QR Code ومزامنة الإكسيل اليومية",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "window-controls-overlay"
  ],
  "orientation": "portrait",
  "theme_color": "#020617",
  "background_color": "#020617",
  "lang": "ar",
  "dir": "rtl",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "512x512",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "فحص الباركود",
      "short_name": "فحص",
      "description": "فتح شاشة المسح والتدقيق الفوري",
      "url": "/?tab=audit",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "تقرير الأخطاء",
      "short_name": "الأخطاء",
      "description": "استعراض وتصدير تقرير النواقص والانحرافات",
      "url": "/?tab=errors",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "بيانات الفواتير اليومية",
      "short_name": "الفواتير",
      "description": "استعراض فواتير اليوم المحملة",
      "url": "/?tab=master",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
